<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:osuautodeafen"
        xmlns:avalonia1="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:views="clr-namespace:osuautodeafen.Views"
        xmlns:viewModels="clr-namespace:osuautodeafen.ViewModels"
        xmlns:helpers="clr-namespace:osuautodeafen.Helpers"
        xmlns:settings="clr-namespace:osuautodeafen.Settings"
        xmlns:progressIndicator="clr-namespace:osuautodeafen.StrainGraph.ProgressIndicator"
        xmlns:acrylic="clr-namespace:Fluid.Avalonia.Acrylic;assembly=Fluid.Avalonia.Acrylic"
        mc:Ignorable="d" d:DesignWidth="150" d:DesignHeight="250"
        x:Class="osuautodeafen.MainWindow"
        Title="osuautodeafen"
        x:DataType="local:MainWindow">

    <Window.DataTemplates>
        <DataTemplate DataType="viewModels:ChangelogViewModel">
            <views:ChangelogView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Brushes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="/Styles/Controls.axaml" />
    </Window.Styles>

    <Grid ZIndex="5" x:DataType="viewModels:SharedViewModel">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0" />
        </Grid.ColumnDefinitions>

        <ContentControl Content="{Binding CurrentPage}" x:DataType="viewModels:SharedViewModel" />

        <Canvas Grid.Column="0" ZIndex="99" IsHitTestVisible="False">

            <Grid x:Name="TooltipRoot"
                  ClipToBounds="True"
                  Opacity="0"
                  IsVisible="False"
                  Background="Transparent">

                <Border x:Name="TooltipBackground"
                        CornerRadius="8"
                        Padding="0"
                        ClipToBounds="True">

                    <acrylic:AcrylicSurface
                        TintColor="{Binding AverageColorBrushDim}"
                        BlurRadius="12"
                        Vibrancy="0.25"
                        HighlightEnabled="True"
                        ShadowEnabled="True"
                        RefractionAmount="25"
                        DepthEffect="True"
                        ChromaticAberration="True"
                        RevealBorderEnabled="True"
                        RevealBorderRadius="35"
                        RevealBorderIntensity="0.25"
                        CornerRadius="8">

                        <Border Background="{Binding Source={StaticResource TooltipColorBrush}}"
                                Opacity="0.5" />

                    </acrylic:AcrylicSurface>
                </Border>

                <TextBlock x:Name="TooltipText"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Regular"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Margin="8" />
            </Grid>
        </Canvas>

        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel x:Name="LogoStackPanel" Margin="0,82,0,0">
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform />
                        <ScaleTransform />
                    </TransformGroup>
                </StackPanel.RenderTransform>

                <StackPanel Orientation="Horizontal"
                            x:Name="osuautodeafenLogoPanel"
                            PointerEntered="LogoPanel_PointerEnter"
                            PointerExited="LogoPanel_PointerExit"
                            Background="Transparent">

                    <Image Name="osuLogo"
                           Source="avares://osuautodeafen/Resources/osu_whitestroke.png"
                           Height="60" />

                    <Grid Width="240" Height="72">
                        <Svg Path="avares://osuautodeafen/Resources/autodeafen.svg"
                             Stretch="Uniform"
                             Css="{Binding AverageColorBrush, Converter={StaticResource BrushToCssConverter}}" />
                    </Grid>
                </StackPanel>

                <TextBlock Text="{Binding CurrentAppVersion}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-10,0,6"
                           Foreground="White"
                           FontSize="16"
                           FontFamily="Inter"
                           FontWeight="Regular"
                           x:Name="VersionPanel"
                           x:DataType="viewModels:SharedViewModel"
                           IsVisible="False"
                           RenderTransformOrigin="0.5,0.0">

                    <TextBlock.RenderTransform>
                        <TranslateTransform />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="DebugConsolePanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Margin="0,20,0,0"
                        IsVisible="False">
                <TextBlock x:Name="DebugConsoleTextBlock"
                           x:DataType="viewModels:SharedViewModel"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Margin="0,20,0,0"
                           Padding="0"
                           FontFamily="Consolas"
                           Foreground="White"
                           IsVisible="False"
                           TextWrapping="Wrap"
                           IsHitTestVisible="True"
                           FontSize="6" />
            </StackPanel>
            <Border x:Name="SettingsButtonContainer" Grid.Column="1" Margin="0,42,0,0"
                    PointerEntered="SettingsButton_PointerEnter"
                    PointerExited="SettingsButton_PointerLeave">
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top">

                    <acrylic:AcrylicSurface
                        Width="50"
                        Height="50"
                        TintColor="{Binding AverageColorBrushDark}"
                        BlurRadius="24"
                        Vibrancy="0.25"
                        HighlightEnabled="True"
                        ShadowEnabled="True"
                        CornerRadius="8,0,0,8"
                        RevealBorderEnabled="True"
                        RevealBorderIntensity="0.1"
                        RevealBorderRadius="50"
                        RefractionAmount="5">

                        <acrylic:AcrylicSurface.OpacityMask>
                            <ImageBrush
                                Source="avares://osuautodeafen/Icons/outline.png"
                                Stretch="Uniform" />
                        </acrylic:AcrylicSurface.OpacityMask>

                    </acrylic:AcrylicSurface>
                    <Button x:Name="SettingsButton"
                            Width="50" Height="50"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            BorderThickness="0"
                            CornerRadius="0"
                            Click="SettingsButton_Click"
                            PointerEntered="SettingsButtonImage_PointerEnter"
                            PointerExited="SettingsButtonImage_PointerLeave"
                            IsVisible="True"
                            ZIndex="1">
                        <Svg x:Name="SettingsCogImage"
                             Path="Icons/gear.svg"
                             Width="50"
                             Height="50"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="0" x:Name="MainContainer" />

        <Grid Grid.Column="0" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Top"
                       x:DataType="viewModels:SharedViewModel" Margin="0,0,0,0" Foreground="#ff3333" FontSize="14" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding SettingsPanelWidth}" />
                </Grid.ColumnDefinitions>

                <avalonia1:CartesianChart
                    x:Name="PlotView"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="120" />

                <progressIndicator:ProgressIndicatorOverlay
                    x:Name="ProgressOverlay"
                    Grid.Column="0"
                    IsHitTestVisible="False" />

                <Canvas x:Name="IconOverlay"
                        Grid.Column="0"
                        IsHitTestVisible="False"
                        x:DataType="viewModels:SharedViewModel" />
            </Grid>


            <Grid Grid.Row="2"
                  x:Name="UpdateNotificationGrid"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Bottom"
                  IsVisible="{Binding IsVisible, ElementName=UpdateNotificationBar}">

                <Button x:Name="UpdateNotificationBar"
                        Classes="update-bar"
                        IsVisible="False"
                        HorizontalAlignment="Stretch"
                        Height="36"
                        Padding="0"
                        FontSize="12"
                        Foreground="White"
                        x:DataType="viewModels:SharedViewModel"
                        Click="UpdateNotificationBar_Click">

                    <Grid>
                        <acrylic:AcrylicSurface
                            CornerRadius="6"
                            TintColor="{Binding AverageColorBrushDark}"
                            BlurRadius="18"
                            Vibrancy="0.18"
                            Contrast="1.08"
                            RefractionAmount="2"
                            DepthEffect="True"
                            ChromaticAberration="True"
                            HighlightEnabled="True"
                            ShadowEnabled="True"
                            IsHitTestVisible="False" />

                        <ProgressBar x:Name="UpdateProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding UpdateProgress}"
                                     Foreground="{Binding AverageColorBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsHitTestVisible="False"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     Opacity="0.65">

                            <ProgressBar.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Value"
                                                      Duration="0:0:0.20" />
                                </Transitions>
                            </ProgressBar.Transitions>
                        </ProgressBar>

                        <TextBlock Text="A new update is available!"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Button>
            </Grid>

        </Grid>
        <Border
            Background="#AA000000"
            ZIndex="98"
            IsVisible="{Binding Changelog, Converter={StaticResource NullToBoolConverter}}">

            <ContentControl
                Content="{Binding Changelog}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>